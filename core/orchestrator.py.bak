"""
Orquestador principal de Mía Isabella.

Flujo:

mensaje
   ↓
memoria episódica
   ↓
problema cognitivo
   ↓
Cognitive Core
   ↓
contexto cognitivo
   ↓
motor de inferencia
   ↓
respuesta
   ↓
memoria episódica
   ↓
extracción opcional de conocimiento

El Orchestrator NO depende de un modelo concreto.

Qwen, Phi, Gemma, otro GGUF o cualquier backend compatible
son únicamente motores lingüísticos.
"""

import logging

from datetime import datetime
from typing import List, Optional

from internal.schemas import (
    Message,
    MessageRole,
    Episode,
)

from contracts.inference import (
    InferenceEngineProtocol,
)

from memory.storage.episodic_repository import (
    EpisodicRepository,
)

from cognition.cognitive_supervisor import (
    CognitiveSupervisor,
)

from cognition.models import Problem


logger = logging.getLogger(__name__)


class Orchestrator:

    def __init__(
        self,
        inference_engine: InferenceEngineProtocol,
        episodic_repo: EpisodicRepository,
        knowledge_extractor=None,
        vector_repo=None,
        cognitive_supervisor: Optional[
            CognitiveSupervisor
        ] = None,
        system_prompt: str = (
            "Eres Mía Isabella, una asistente personal "
            "amigable, útil, responsable y precisa."
        ),
    ):

        self.inference = inference_engine

        self.episodic_repo = episodic_repo

        self.knowledge_extractor = (
            knowledge_extractor
        )

        self.vector_repo = vector_repo

        self.system_prompt = system_prompt

        self.cognitive = (
            cognitive_supervisor
            or CognitiveSupervisor()
        )

        logger.debug(
            "Orchestrator inicializado"
        )

    # =============================================================
    # PROCESAMIENTO PRINCIPAL
    # =============================================================

    def process_message(
        self,
        user_message: Message,
    ) -> Message:
        """
        Procesa un mensaje completo.

        El flujo está diseñado para degradarse de forma segura:

        memoria
            ↓
        cognición
            ↓
        inferencia
            ↓
        almacenamiento
        """

        logger.debug(
            "Procesando mensaje del usuario"
        )

        # =========================================================
        # 1. MEMORIA RECIENTE
        # =========================================================

        try:

            recent_episodes = (
                self.episodic_repo.get_recent_episodes(
                    limit=5
                )
            )

        except Exception as exc:

            logger.exception(
                "Error recuperando memoria episódica: %s",
                exc,
            )

            recent_episodes = []

        context_str = self._build_context(
            recent_episodes
        )

        # =========================================================
        # 2. PROBLEMA COGNITIVO
        # =========================================================

        problem = Problem(
            description=user_message.content,

            objective=(
                "Responder correctamente al usuario."
            ),

            known_facts=(
                self._extract_context_facts(
                    recent_episodes
                )
            ),

            unknowns=[],

            constraints=[
                (
                    "No ejecutar acciones reales "
                    "desde el Cognitive Core."
                ),
                (
                    "No modificar archivos "
                    "sin autorización."
                ),
                (
                    "No asumir hechos no respaldados "
                    "por evidencia."
                ),
            ],

            assumptions=[],

            resources=[
                "memoria episódica",
                "motor de inferencia",
                "Cognitive Core",
            ],
        )

        # =========================================================
        # 3. COGNITIVE CORE
        # =========================================================

        logger.debug(
            "Ejecutando Cognitive Core"
        )

        cognitive_result = None

        try:

            cognitive_result = (
                self.cognitive.solve(
                    problem
                )
            )

            logger.debug(
                "Cognitive Core: "
                "confidence=%.2f "
                "uncertainty=%.2f "
                "decision=%s",

                cognitive_result.confidence,

                cognitive_result.uncertainty,

                (
                    cognitive_result.decision.action
                    if cognitive_result.decision
                    else "none"
                ),
            )

        except Exception as exc:

            logger.exception(
                "Error en Cognitive Core: %s",
                exc,
            )

        # =========================================================
        # 4. CONTEXTO COGNITIVO
        # =========================================================

        cognitive_context = ""

        if cognitive_result is not None:

            cognitive_context = (
                self._build_cognitive_context(
                    cognitive_result
                )
            )

        # =========================================================
        # 5. PROMPT
        # =========================================================

        prompt = self._build_prompt(
            context=context_str,
            user_input=user_message.content,
            cognitive_context=cognitive_context,
        )

        # =========================================================
        # 6. INFERENCIA
        # =========================================================

        logger.debug(
            "Solicitando inferencia..."
        )

        try:

            response_text = (
                self.inference.generate(
                    prompt,
                    max_tokens=300,
                    temperature=0.7,
                )
            )

        except Exception as exc:

            logger.exception(
                "Error en motor de inferencia: %s",
                exc,
            )

            response_text = (
                "He procesado tu mensaje, pero "
                "el motor lingüístico no está disponible "
                "en este momento."
            )

        if not response_text:
            response_text = (
                "No pude generar una respuesta."
            )

        # =========================================================
        # 7. RESPUESTA
        # =========================================================

        assistant_message = Message(
            role=MessageRole.ASSISTANT,

            content=response_text,

            timestamp=datetime.now(),
        )

        # =========================================================
        # 8. GUARDAR EPISODIO
        # =========================================================

        episode = Episode(
            messages=[
                user_message,
                assistant_message,
            ],

            start_time=user_message.timestamp,

            end_time=assistant_message.timestamp,
        )

        try:

            self.episodic_repo.save_episode(
                episode
            )

        except Exception as exc:

            logger.exception(
                "No se pudo guardar el episodio: %s",
                exc,
            )

        # =========================================================
        # 9. EXTRAER CONOCIMIENTO
        # =========================================================

        if self.knowledge_extractor:

            try:

                self.knowledge_extractor.extract_and_store(
                    episode
                )

                logger.debug(
                    "Extracción de conocimiento completada"
                )

            except Exception as exc:

                logger.exception(
                    "Error en extracción de conocimiento: %s",
                    exc,
                )

        return assistant_message

    # =============================================================
    # CONTEXTO DE MEMORIA
    # =============================================================

    def _build_context(
        self,
        episodes: List[Episode],
    ) -> str:
        """
        Construye contexto conversacional reciente.

        Esto es contexto temporal, no conocimiento permanente.
        """

        lines = []

        # Los episodios vienen DESC.
        # Los invertimos para construir el contexto
        # cronológicamente.

        for episode in reversed(episodes):

            for message in episode.messages:

                if message.role == MessageRole.USER:
                    role = "Usuario"

                else:
                    role = "Asistente"

                content = (
                    message.content.strip()
                    if message.content
                    else ""
                )

                if not content:
                    continue

                lines.append(
                    f"{role}: {content}"
                )

        return "\n".join(lines)

    # =============================================================
    # HECHOS DE CONTEXTO
    # =============================================================

    def _extract_context_facts(
        self,
        episodes: List[Episode],
    ) -> List[str]:
        """
        Extrae contexto estructurado para el Cognitive Core.

        IMPORTANTE:

        Un mensaje conversacional NO se considera automáticamente
        un hecho.

        Aquí utilizamos únicamente:

        - resumen del episodio
        - context_snapshot
        """

        facts = []

        for episode in episodes:

            if episode.summary:

                summary = (
                    episode.summary.strip()
                )

                if summary:
                    facts.append(summary)

            if episode.context_snapshot:

                snapshot = (
                    episode.context_snapshot
                )

                if isinstance(
                    snapshot,
                    dict,
                ):

                    for key, value in snapshot.items():

                        if value is None:
                            continue

                        facts.append(
                            f"{key}: {value}"
                        )

        return facts[-10:]

    # =============================================================
    # CONTEXTO COGNITIVO
    # =============================================================

    def _build_cognitive_context(
        self,
        result,
    ) -> str:
        """
        Convierte CognitiveResult en contexto legible
        para el motor lingüístico.

        El LLM recibe el resultado del Cognitive Core,
        pero no controla el Cognitive Core.
        """

        lines = [
            "=== CONTEXTO COGNITIVO ===",

            (
                f"Confianza: "
                f"{result.confidence:.2f}"
            ),

            (
                f"Incertidumbre: "
                f"{result.uncertainty:.2f}"
            ),
        ]

        if result.needs_more_information:

            lines.append(
                "Se necesita información adicional."
            )

        # ---------------------------------------------------------
        # HIPÓTESIS
        # ---------------------------------------------------------

        if result.hypotheses:

            lines.append(
                "\nHipótesis consideradas:"
            )

            for hypothesis in result.hypotheses[:3]:

                lines.append(
                    "- "
                    f"{hypothesis.statement} "
                    f"(confianza="
                    f"{hypothesis.confidence:.2f}, "
                    f"estado="
                    f"{hypothesis.status.value})"
                )

        # ---------------------------------------------------------
        # PLAN
        # ---------------------------------------------------------

        if result.plan:

            lines.append(
                "\nPlan cognitivo:"
            )

            for step in result.plan.steps[:5]:

                lines.append(
                    f"- {step.action}"
                )

        # ---------------------------------------------------------
        # DECISIÓN
        # ---------------------------------------------------------

        if result.decision:

            lines.append(
                "\nDecisión cognitiva:"
            )

            lines.append(
                "- "
                f"Acción: "
                f"{result.decision.action}"
            )

            lines.append(
                "- "
                f"Estado: "
                f"{result.decision.status.value}"
            )

            if result.decision.rationale:

                lines.append(
                    "- Fundamentación:"
                )

                for reason in (
                    result.decision.rationale[:5]
                ):

                    lines.append(
                        f"  - {reason}"
                    )

        # ---------------------------------------------------------
        # PREGUNTAS
        # ---------------------------------------------------------

        if result.questions:

            lines.append(
                "\nInformación pendiente:"
            )

            for question in result.questions[:5]:

                lines.append(
                    f"- {question}"
                )

        return "\n".join(lines)

    # =============================================================
    # PROMPT
    # =============================================================

    def _build_prompt(
        self,
        context: str,
        user_input: str,
        cognitive_context: str = "",
    ) -> str:
        """
        Construye el prompt final.

        El modelo lingüístico recibe:

        1. identidad del asistente
        2. historial reciente
        3. resultado cognitivo
        4. mensaje actual

        El modelo no decide la arquitectura.
        Solo genera lenguaje.
        """

        prompt = (
            "<|system|>\n"
            f"{self.system_prompt}\n"
        )

        if context:

            prompt += (
                "\nHistorial reciente:\n"
                f"{context}\n"
            )

        if cognitive_context:

            prompt += (
                "\n"
                f"{cognitive_context}\n"
            )

        prompt += (
            "<|user|>\n"
            f"{user_input}\n"
            "<|assistant|>\n"
        )

        return prompt
