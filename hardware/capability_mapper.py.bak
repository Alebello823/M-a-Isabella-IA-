from pathlib import Path
from typing import Any, Dict, List, Optional

import yaml


class CapabilityMapper:
    """
    Carga los perfiles de hardware de Mía Isabella y selecciona
    el perfil más apropiado según la RAM disponible.

    El mapper está diseñado para tolerar:
      - YAML vacío
      - documentos YAML con contenido inválido
      - perfiles que no sean diccionarios
      - archivos inexistentes
      - valores de RAM incorrectos
    """

    def __init__(self, profiles_dir: Path):
        self.profiles_dir = Path(profiles_dir)
        self.profiles: List[Dict[str, Any]] = self._load_profiles(
            self.profiles_dir
        )

    def _load_profiles(self, profiles_dir: Path) -> List[Dict[str, Any]]:
        """
        Carga todos los perfiles YAML válidos del directorio.
        """

        profiles: List[Dict[str, Any]] = []

        if not profiles_dir.exists():
            return profiles

        if not profiles_dir.is_dir():
            return profiles

        for profile_file in sorted(profiles_dir.glob("*.yaml")):
            try:
                with profile_file.open("r", encoding="utf-8") as fh:
                    data = yaml.safe_load(fh)

                # Un YAML vacío devuelve None.
                if data is None:
                    continue

                # Algunos perfiles pueden contener una lista.
                if isinstance(data, list):
                    profiles.extend(
                        item
                        for item in data
                        if isinstance(item, dict)
                    )
                    continue

                # Perfil YAML normal: diccionario.
                if isinstance(data, dict):
                    # Guardamos también el archivo de origen.
                    data["_profile_file"] = str(profile_file)
                    profiles.append(data)

            except yaml.YAMLError:
                # Un perfil defectuoso no debe tumbar todo el kernel.
                continue

            except (OSError, UnicodeError):
                # Error de lectura de archivo.
                continue

        # BLINDAJE:
        # nunca permitimos que None u otros objetos lleguen al sort().
        profiles = [
            p for p in profiles
            if isinstance(p, dict)
        ]

        return sorted(
            profiles,
            key=lambda p: self._ram_value(
                p.get("min_ram_gb", 0)
            )
        )

    @staticmethod
    def _ram_value(value: Any) -> float:
        """
        Convierte min_ram_gb a float de forma segura.
        """

        try:
            return float(value)
        except (TypeError, ValueError):
            return 0.0

        def select_profile(
        self,
        ram_gb: float,
        manual_tier: Optional[str] = None,
    ) -> Optional[Dict[str, Any]]:
        """
        Selecciona el perfil de hardware.

        Si manual_tier está especificado, se intenta utilizar
        ese perfil explícitamente.

        Si no existe manual_tier, se selecciona automáticamente
        según la RAM disponible.
        """

        # Selección manual solicitada por Kernel/configuración.
        if manual_tier:
            for profile in self.profiles:
                if profile.get("tier") == manual_tier:
                    return profile

        # Selección automática según RAM.
        return self.get_profile_for_ram(ram_gb)

    def get_profile_for_ram(
        self,
        ram_gb: float,
    ) -> Optional[Dict[str, Any]]:
        """
        Devuelve el perfil con mayor min_ram_gb que sea compatible
        con la RAM disponible.

        Ejemplo:
            RAM = 2.1 GB
            -> selecciona el perfil de menor requisito compatible.

            RAM = 6.5 GB
            -> puede seleccionar tier_5_pc.
        """

        if not self.profiles:
            return None

        compatible = [
            profile
            for profile in self.profiles
            if self._ram_value(
                profile.get("min_ram_gb", 0)
            ) <= ram_gb
        ]

        if not compatible:
            # Si ningún perfil coincide, usamos el más pequeño.
            return self.profiles[0]

        return max(
            compatible,
            key=lambda p: self._ram_value(
                p.get("min_ram_gb", 0)
            )
        )

    def get_profile(
        self,
        ram_gb: float,
    ) -> Optional[Dict[str, Any]]:
        """
        Alias compatible con código que utilice get_profile().
        """

        return self.get_profile_for_ram(ram_gb)

    def get_recommended_model(
        self,
        ram_gb: float,
    ) -> Optional[str]:
        """
        Devuelve el modelo recomendado para la RAM disponible.
        """

        profile = self.get_profile_for_ram(ram_gb)

        if not profile:
            return None

        model = profile.get("recommended_model")

        if not model:
            return None

        return str(model)

    def get_model_path(
        self,
        ram_gb: float,
    ) -> Optional[Path]:
        """
        Devuelve la ruta absoluta del modelo recomendado.
        """

        model = self.get_recommended_model(ram_gb)

        if not model:
            return None

        model_path = Path(model)

        if model_path.is_absolute():
            return model_path

        # PROJECT_ROOT:
        # capability_mapper.py está en hardware/
        # por lo tanto parents[1] es ~/MiaIsabella
        project_root = Path(__file__).resolve().parents[1]

        return (project_root / model_path).resolve()

    def describe(self) -> List[Dict[str, Any]]:
        """
        Devuelve una descripción limpia de los perfiles cargados.
        """

        result = []

        for profile in self.profiles:
            result.append(
                {
                    "tier": profile.get("tier"),
                    "min_ram_gb": self._ram_value(
                        profile.get("min_ram_gb", 0)
                    ),
                    "recommended_model": profile.get(
                        "recommended_model"
                    ),
                    "profile_file": profile.get(
                        "_profile_file"
                    ),
                }
            )

        return result
