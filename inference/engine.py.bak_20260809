"""
Motor de inferencia local de Mía Isabella.

Responsabilidades:
- Ejecutar llama-cli como backend local.
- No depender de un modelo concreto.
- Consumir una única generación por llamada.
- Evitar el modo interactivo de llama-cli.
- Devolver únicamente el texto generado.
- Mantener una interfaz estable para el Orchestrator.

El modelo utilizado se determina mediante configuración.
Este módulo NO conoce ni depende de Qwen, Phi, Llama u otro modelo
concreto.
"""

import logging
import os
import shutil
import subprocess
from pathlib import Path
from typing import Optional


logger = logging.getLogger(__name__)


class InferenceEngine:
    """
    Motor de inferencia basado en llama-cli.

    El backend es intercambiable siempre que respete la interfaz
    generate(prompt, max_tokens, temperature).
    """

    def __init__(
        self,
        model_path,
        n_ctx: int = 2048,
        n_threads: int = 4,
        max_tokens: int = 256,
        temperature: float = 0.7,
        llama_cli: Optional[str] = None,
        timeout: int = 180,
    ):
        self.model_path = Path(model_path)
        self.n_ctx = int(n_ctx)
        self.n_threads = int(n_threads)
        self.max_tokens = int(max_tokens)
        self.temperature = float(temperature)
        self.timeout = int(timeout)

        # ---------------------------------------------------------
        # Buscar llama-cli
        # ---------------------------------------------------------

        self.llama_cli = (
            llama_cli
            or shutil.which("llama-cli")
        )

        if not self.llama_cli:
            raise RuntimeError(
                "No se encontró llama-cli en PATH.\n"
                "Instala llama.cpp mediante Termux si es necesario."
            )

        # ---------------------------------------------------------
        # Validar modelo
        # ---------------------------------------------------------

        if not self.model_path.exists():
            raise FileNotFoundError(
                f"No existe el modelo local: {self.model_path}"
            )

        if not self.model_path.is_file():
            raise RuntimeError(
                f"La ruta del modelo no es un archivo: "
                f"{self.model_path}"
            )

        logger.info(
            "Inicializando motor llama.cpp"
        )

        logger.info(
            "llama-cli: %s",
            self.llama_cli,
        )

        logger.info(
            "Modelo: %s",
            self.model_path,
        )

        logger.info(
            "Contexto: %s",
            self.n_ctx,
        )

        logger.info(
            "Threads: %s",
            self.n_threads,
        )

        logger.info(
            "Max tokens: %s",
            self.max_tokens,
        )

        logger.info(
            "Temperature: %.2f",
            self.temperature,
        )

        self._verify_backend()

        logger.info(
            "Motor de inferencia inicializado correctamente"
        )

    # =============================================================
    # VERIFICACIÓN
    # =============================================================

    def _verify_backend(self) -> None:
        """
        Comprueba que llama-cli pueda ejecutarse.

        No carga el modelo completo. Solo verifica el ejecutable.
        """

        try:
            result = subprocess.run(
                [
                    self.llama_cli,
                    "--version",
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=10,
                check=False,
            )

        except subprocess.TimeoutExpired as exc:
            raise RuntimeError(
                "llama-cli tardó demasiado en responder."
            ) from exc

        except OSError as exc:
            raise RuntimeError(
                f"No se pudo ejecutar llama-cli: {exc}"
            ) from exc

        if result.returncode != 0:
            raise RuntimeError(
                "llama-cli está instalado pero "
                "no pudo ejecutarse.\n"
                f"{result.stderr.strip()}"
            )

        version = result.stdout.strip()

        if version:
            logger.info(
                "llama.cpp disponible: %s",
                version.splitlines()[0],
            )

    # =============================================================
    # GENERACIÓN
    # =============================================================

    def generate(
        self,
        prompt: str,
        max_tokens: Optional[int] = None,
        temperature: Optional[float] = None,
    ) -> str:
        """
        Genera una única respuesta mediante llama-cli.

        IMPORTANTE:

        llama-cli puede entrar automáticamente en modo conversación
        cuando el modelo posee una plantilla de chat.

        Para el uso de Mía Isabella esto no es deseable porque el
        proceso es controlado por Python.

        Por eso utilizamos:

            --single-turn
            --no-display-prompt
            --no-show-timings
            --simple-io

        De esta forma:

            Python
              |
              v
        Orchestrator
              |
              v
        InferenceEngine
              |
              v
        llama-cli
              |
              v
        una respuesta
              |
              v
        Python

        llama-cli termina después de generar.
        """

        if not prompt or not prompt.strip():
            return ""

        # ---------------------------------------------------------
        # Valores efectivos
        # ---------------------------------------------------------

        if max_tokens is None:
            max_tokens = self.max_tokens

        if temperature is None:
            temperature = self.temperature

        max_tokens = max(
            1,
            int(max_tokens),
        )

        temperature = max(
            0.0,
            float(temperature),
        )

        # ---------------------------------------------------------
        # Comando
        # ---------------------------------------------------------

        command = [
            self.llama_cli,

            "-m",
            str(self.model_path),

            "-c",
            str(self.n_ctx),

            "-n",
            str(max_tokens),

            "-t",
            str(self.n_threads),

            "--temp",
            str(temperature),

            # Prompt controlado por Python.
            "-p",
            prompt,

            # Una sola generación y salir.
            "--single-turn",

            # No imprimir el prompt dentro de stdout.
            "--no-display-prompt",

            # No imprimir estadísticas de timing.
            "--no-show-timings",

            # Mejor compatibilidad con subprocess.
            "--simple-io",

            # Sin colores ANSI.
            "--color",
            "off",
        ]

        logger.debug(
            "Ejecutando inferencia local."
        )

        logger.debug(
            "Modelo de inferencia: %s",
            self.model_path.name,
        )

        try:
            process = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                encoding="utf-8",
                errors="replace",
                timeout=self.timeout,
                check=False,
                env=self._build_environment(),
            )

        except subprocess.TimeoutExpired as exc:
            logger.error(
                "Timeout durante inferencia: %s segundos",
                self.timeout,
            )

            raise RuntimeError(
                "La inferencia excedió el tiempo máximo "
                f"de {self.timeout} segundos."
            ) from exc

        except OSError as exc:
            logger.exception(
                "Error ejecutando llama-cli."
            )

            raise RuntimeError(
                f"No se pudo ejecutar llama-cli: {exc}"
            ) from exc

        # ---------------------------------------------------------
        # Error de proceso
        # ---------------------------------------------------------

        if process.returncode != 0:

            stderr = (
                process.stderr.strip()
                if process.stderr
                else ""
            )

            logger.error(
                "llama-cli terminó con código %s",
                process.returncode,
            )

            if stderr:
                logger.error(
                    "llama-cli stderr: %s",
                    stderr,
                )

            raise RuntimeError(
                "llama-cli terminó con un error. "
                f"Código: {process.returncode}. "
                f"{stderr}"
            )

        # ---------------------------------------------------------
        # Extraer respuesta
        # ---------------------------------------------------------

        response = self._clean_output(
            process.stdout
        )

        if not response:

            stderr = (
                process.stderr.strip()
                if process.stderr
                else ""
            )

            logger.warning(
                "llama-cli no produjo texto."
            )

            if stderr:
                logger.warning(
                    "llama-cli stderr: %s",
                    stderr,
                )

            raise RuntimeError(
                "llama-cli no produjo una respuesta válida."
            )

        logger.debug(
            "Inferencia completada: %d caracteres",
            len(response),
        )

        return response

    # =============================================================
    # LIMPIEZA DE SALIDA
    # =============================================================

    @staticmethod
    def _clean_output(output: Optional[str]) -> str:
        """
        Limpia stdout sin destruir el contenido generado.

        No intenta interpretar el modelo ni modificar la respuesta.
        """

        if not output:
            return ""

        text = output.replace("\r\n", "\n")
        text = text.replace("\r", "\n")

        lines = []

        for line in text.splitlines():

            stripped = line.strip()

            # Ruido típico del CLI.
            if not stripped:
                continue

            if stripped.startswith("[ Prompt:"):
                continue

            if stripped.startswith("[ Generation:"):
                continue

            lines.append(
                line.rstrip()
            )

        return "\n".join(lines).strip()

    # =============================================================
    # ENTORNO
    # =============================================================

    @staticmethod
    def _build_environment():
        """
        Construye un entorno controlado para llama-cli.

        No fuerza ningún modelo.
        """

        env = os.environ.copy()

        # Evita que configuraciones externas de color
        # interfieran con stdout.
        env.setdefault(
            "TERM",
            "dumb",
        )

        return env

    # =============================================================
    # INFORMACIÓN
    # =============================================================

    def info(self) -> dict:
        """
        Devuelve información estructurada del motor.
        """

        return {
            "backend": "llama.cpp",
            "executable": self.llama_cli,
            "model": str(self.model_path),
            "context": self.n_ctx,
            "threads": self.n_threads,
            "max_tokens": self.max_tokens,
            "temperature": self.temperature,
            "timeout": self.timeout,
        }
